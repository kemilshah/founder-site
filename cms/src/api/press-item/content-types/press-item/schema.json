{
  "kind": "collectionType",
  "collectionName": "press_items",
  "info": {
    "singularName": "press-item",
    "pluralName": "press-items",
    "displayName": "Press Item",
    "description": "Media features and interviews"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "publication": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "thumbnail": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    }
  }
}