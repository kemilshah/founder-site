{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Per-page hero/content text, one entry per site page (slug)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "eyebrow": {
      "type": "string"
    },
    "heading": {
      "type": "string",
      "required": true
    },
    "intro": {
      "type": "text"
    },
    "secondaryHeading": {
      "type": "string"
    },
    "secondaryBody": {
      "type": "text"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "ledgerStats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "pageImage": {
      "type": "media",
      "allowedTypes": [
        "images"
      ],
      "multiple": false
    }
  }
}
